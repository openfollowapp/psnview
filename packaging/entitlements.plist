<!--
  Hardened-runtime exceptions needed by a PyInstaller-packaged Python/Qt app:
  CPython (ctypes/libffi) allocates executable memory, and the bundle dlopens
  its own extension modules and Qt plugins. Applied by psnview.spec when
  CODESIGN_IDENTITY is set. No network entitlements are needed because the
  app is not sandboxed.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
